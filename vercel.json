  "buildCommand": "pnpm --filter @workspace/904-meal-prepz run build",
  "outputDirectory": "artifacts/904-meal-prepz/dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" },
